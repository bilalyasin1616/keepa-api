{
  "name": "keepa-api",
  "version": "0.2.0",
  "description": "TypeScript SDK for the Keepa API.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx examples/basic.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "keepa",
    "amazon",
    "api",
    "sdk",
    "asin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bilalyasin1616/keepa-api.git"
  },
  "bugs": {
    "url": "https://github.com/bilalyasin1616/keepa-api/issues"
  },
  "homepage": "https://github.com/bilalyasin1616/keepa-api#readme",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
